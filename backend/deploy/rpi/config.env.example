# Copy to config.env on the Raspberry Pi. This file contains no passwords.
VIBEFIT_HOST=vibefit.home.example
TZ=Asia/Shanghai

POSTGRES_USER=vibefit
POSTGRES_DB=vibefit
VIBEFIT_DATA_DIR=/srv/vibefit/data

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=replace@example.com
SMTP_FROM=replace@example.com
VERIFY_CODE_TTL_SECONDS=300
VERIFY_CODE_LENGTH=6

# Optional host paths. Relative paths are resolved from this deployment directory.
POSTGRES_PASSWORD_FILE_PATH=./secrets/postgres_password
DATABASE_URL_FILE_PATH=./secrets/database_url
JWT_SECRET_FILE_PATH=./secrets/jwt_secret
SMTP_PASSWORD_FILE_PATH=./secrets/smtp_password
TLS_CERT_FILE_PATH=./secrets/tls_cert.pem
TLS_KEY_FILE_PATH=./secrets/tls_key.pem
ROOT_CA_FILE_PATH=./secrets/root_ca.pem
# Optional until backups, restore rehearsals, or upgrades are used.
RESTIC_PASSWORD_FILE_PATH=./secrets/restic_password

# Scheduled backups are deliberately disabled until a real destination is chosen.
BACKUP_ENABLED=false
BACKUP_HOST=vibefit-rpi
VIBEFIT_BACKUP_DIR=/srv/vibefit/backup-not-configured
VIBEFIT_BACKUP_WORK_DIR=/srv/vibefit/backup-work
VIBEFIT_RESTORE_DIR=/srv/vibefit/restore-work
RESTIC_CHECK_SUBSET=5%
