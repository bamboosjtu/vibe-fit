PORT=8080
NODE_ENV=development
APP_VERSION=1.1.0
GIT_REVISION=development
DATABASE_SCHEMA_VERSION=1

# 认证模式：
#   email — 邮箱验证码登录（默认，本地部署）
#   mock  — 仅用于测试，验证码直接返回不发邮件
AUTH_MODE=email
# 数据模式：
#   postgres — PostgreSQL（默认，本地 Docker）
#   mock     — 内存数据，仅用于测试
DATA_MODE=postgres
# 事件发布模式：
#   local — 本地 HTTP push 到 worker（默认，本地 Docker）
#   mock  — 仅日志输出，仅用于测试
EVENT_PUBLISHER=local

# Docker 以 NODE_ENV=production 运行，必须换成至少 32 个字符的随机值。
JWT_SECRET=replace-with-at-least-32-random-characters
# Docker secrets 也可使用 JWT_SECRET_FILE=/run/secrets/jwt_secret；同一变量与 *_FILE 不可同时设置。

# 本地前端地址。多个 origin 用逗号分隔。
CORS_ORIGIN=http://localhost:8081,http://localhost:8080,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:8080,http://127.0.0.1:5173

LOG_PRETTY=false

DATABASE_URL="postgres://vibefit:vibefit_dev_password@localhost:5432/vibefit_dev"
# 生产环境建议改用 DATABASE_URL_FILE。

# ===== 邮箱验证码（163 邮箱）=====
# 本地部署时由用户填写。AUTH_MODE=email 时必须配置 SMTP_HOST/SMTP_USER/SMTP_PASS。
# 163 邮箱配置示例：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USER=your_email@163.com
#   SMTP_PASS=你的163邮箱授权码（不是登录密码）
#   SMTP_FROM=your_email@163.com（可选，默认用 SMTP_USER）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 生产环境建议改用 SMTP_PASS_FILE。
SMTP_FROM=

# 验证码有效期（秒）与长度
VERIFY_CODE_TTL_SECONDS=300
VERIFY_CODE_LENGTH=6

# 本地事件推送：worker 的 HTTP 端点（Docker 网络内）
WORKER_PUSH_URL=http://worker:8080/pubsub/backups

# 快照请求和 Worker 保留策略
MAX_BACKUP_BYTES=10485760
BACKUP_RETENTION_DAYS=90
BACKUP_MIN_SNAPSHOTS=10
