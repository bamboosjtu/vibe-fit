{
  "name": "vibefit-backend",
  "version": "1.1.0",
  "description": "VibeFit backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/backend.test.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.3",
    "fastify-plugin": "^5.0.0",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
