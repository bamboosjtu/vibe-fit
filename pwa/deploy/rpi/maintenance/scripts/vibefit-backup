#!/bin/sh
set -eu
umask 077

if [ "${BACKUP_ENABLED:-false}" != "true" ]; then
  echo "BACKUP_ENABLED=true is required; scheduled backups are disabled by default." >&2
  exit 64
fi
if [ -z "${DATABASE_URL_FILE:-}" ] || [ ! -r "$DATABASE_URL_FILE" ]; then
  echo "DATABASE_URL_FILE must point to a readable secret." >&2
  exit 66
fi
if [ -z "${RESTIC_REPOSITORY:-}" ] || [ -z "${RESTIC_PASSWORD_FILE:-}" ]; then
  echo "RESTIC_REPOSITORY and RESTIC_PASSWORD_FILE are required." >&2
  exit 64
fi
if [ ! -r "$RESTIC_PASSWORD_FILE" ]; then
  echo "RESTIC_PASSWORD_FILE is not readable: $RESTIC_PASSWORD_FILE" >&2
  exit 66
fi
if ! restic cat config >/dev/null 2>&1; then
  echo "Restic repository is not initialized. Run the maintenance init command first." >&2
  exit 65
fi

database_url=$(tr -d '\r\n' < "$DATABASE_URL_FILE")
work_root=${BACKUP_WORK_DIR:-/work}
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
work_dir="$work_root/$timestamp"
dump_file="$work_dir/vibefit-$timestamp.dump"
checksum_file="$dump_file.sha256"
mkdir -p "$work_dir"
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

pg_dump --dbname="$database_url" --format=custom --file="$dump_file"
pg_restore --list "$dump_file" >/dev/null
checksum_line=$(sha256sum "$dump_file")
dump_hash=${checksum_line%% *}
echo "$dump_hash" | grep -Eq '^[0-9a-f]{64}$'
printf '%s  %s\n' "$dump_hash" "$(basename "$dump_file")" > "$checksum_file"

set -- "$dump_file" "$checksum_file"
server_config_dir=${SERVER_CONFIG_DIR:-/server-config}
# Only non-secret runtime metadata and the public leaf certificate are archived.
# Database/JWT/SMTP secrets and the TLS private key are deliberately excluded.
for config_name in compose.yaml Caddyfile config.env images.lock.env tls_cert.pem; do
  if [ -f "$server_config_dir/$config_name" ]; then
    set -- "$@" "$server_config_dir/$config_name"
  fi
done

restic backup "$@" \
  --tag vibefit-server \
  --host "${BACKUP_HOST:-vibefit-rpi}"
restic forget \
  --tag vibefit-server \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 6 \
  --prune

echo "Backup completed and verified: $timestamp"
